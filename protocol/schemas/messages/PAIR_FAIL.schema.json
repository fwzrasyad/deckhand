{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deckhand.local/protocol/schemas/messages/PAIR_FAIL.schema.json",
  "title": "PAIR_FAIL payload",
  "description": "Sent by the daemon when pairing fails. The daemon closes the connection with 4401 immediately after. See SRD Sections 4.4 and 7.5.",
  "type": "object",
  "required": ["code"],
  "additionalProperties": true,
  "properties": {
    "code": { "type": "string", "description": "Machine-readable pairing failure code.", "enum": ["PAIR_WINDOW_CLOSED", "PAIR_BAD_PROOF", "PAIR_LOCKED_OUT"], "examples": ["PAIR_BAD_PROOF"] }
  }
}