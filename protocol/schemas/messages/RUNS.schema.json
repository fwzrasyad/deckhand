{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deckhand.local/protocol/schemas/messages/RUNS.schema.json",
  "title": "RUNS payload",
  "description": "Answer to RUNS_LIST. See SRD Sections 7.5 and 7.6.",
  "type": "object",
  "required": ["runs"],
  "additionalProperties": true,
  "properties": {
    "runs": { "type": "array", "description": "Runs known to the daemon, newest first.", "items": { "$ref": "https://deckhand.local/protocol/schemas/shared/RunState.schema.json" } }
  }
}