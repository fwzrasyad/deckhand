<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent for the Deckhand daemon (SRD 13.2).

     Install to ~/Library/LaunchAgents/app.deckhand.daemon.plist and load with:
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/app.deckhand.daemon.plist

     `deckhand autostart enable` writes this file for you (Phase 3). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>app.deckhand.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/deckhand</string>
        <string>serve</string>
        <string>--no-tray</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/deckhand.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/deckhand.err.log</string>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
